# =========================================================
# Staff de Estelar Oficial — Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" real a git ni lo compartas.
# =========================================================

# Token del bot "Staff de Estelar Oficial" (Discord Developer Portal >
# tu aplicación > Bot > Reset Token). Obligatorio.
DISCORD_TOKEN=tu_token_aqui

# Identifica a este bot. Por ahora solo existe "jefe"; cuando se sumen
# los bots-empleado (developer, disenador, marketing, manager, ui) cada
# uno tendrá su propio BOT_SLUG.
BOT_SLUG=jefe

# Clave de la API de Anthropic (Claude). Puedes usar la misma que ya
# usa TAMAGO, o una separada si prefieres llevar el gasto aparte.
# Consíguela en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=tu_api_key_aqui

# Qué modelo de Claude usar. Opcional.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Segundos mínimos entre dos respuestas de IA a la MISMA persona en el
# MISMO canal (anti-spam). Opcional. Por defecto: 8
AI_COOLDOWN_SECONDS=8

# Máximo de respuestas de IA por minuto (protege el costo de la API).
# Opcional. Por defecto: 10
AI_MAX_RESPONSES_PER_MINUTE=10

# Prefijo para comandos de texto clásicos. Opcional. Por defecto: !
COMMAND_PREFIX=!

# ID del servidor (guild) donde va a operar el bot. Opcional -- solo se
# usa para un mensaje informativo en los logs.
GUILD_ID=

# IDs de los canales de Discord donde el bot puede responder con IA,
# uno por línea o separados por comas. Por seguridad, empieza vacío: el
# bot no responderá con IA en ningún canal hasta que agregues al menos
# uno aquí. Actívalo con "Modo desarrollador" en Discord y clic derecho
# sobre el canal > "Copiar ID de canal".
ALLOWED_CHANNEL_IDS=

# Nivel de detalle de los registros: DEBUG, INFO, WARNING, ERROR
# Opcional. Por defecto: INFO
LOG_LEVEL=INFO

# Tamaño máximo (en MB) por imagen adjunta que el bot procesará con
# IA. Imágenes más pesadas se ignoran (protege el costo de la API).
# Opcional. Por defecto: 5
MAX_IMAGE_SIZE_MB=5

# Máximo de imágenes que el bot procesará en un solo mensaje.
# Opcional. Por defecto: 3
MAX_IMAGES_PER_MESSAGE=3
